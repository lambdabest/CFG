Windows Registry Editor Version 5.00
; MarkC custom profile kept for this setup:
; Windows 10/8.x, 100% scaling, Scale=1-to-1, pointer slider @3-of-11.
; CS 1.6 with m_rawinput 1 uses the raw-input path, so this curve is mainly
; retained here for centralization/legacy mouse paths.

[HKEY_CURRENT_USER\Control Panel\Mouse]

"MouseSensitivity"="4"
"SmoothMouseXCurve"=hex:\
	00,00,00,00,00,00,00,00,\
	AE,1E,05,00,00,00,00,00,\
	5C,3D,0A,00,00,00,00,00,\
	0A,5C,0F,00,00,00,00,00,\
	B8,7A,14,00,00,00,00,00
"SmoothMouseYCurve"=hex:\
	00,00,00,00,00,00,00,00,\
	00,00,38,00,00,00,00,00,\
	00,00,70,00,00,00,00,00,\
	00,00,A8,00,00,00,00,00,\
	00,00,E0,00,00,00,00,00

[HKEY_USERS\.DEFAULT\Control Panel\Mouse]

"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"
